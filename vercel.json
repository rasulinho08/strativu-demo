{
  "redirects": [
    {
      "source": "/company/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/company/contact",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/company",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/platform",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/platform/grc",
      "destination": "/products/grc360",
      "permanent": true
    },
    {
      "source": "/platform/architecture",
      "destination": "/products/grc360/architecture",
      "permanent": true
    },
    {
      "source": "/coverage",
      "destination": "/products/grc360/frameworks",
      "permanent": true
    },
    {
      "source": "/coverage/:slug",
      "destination": "/products/grc360/frameworks/:slug",
      "permanent": true
    },
    {
      "source": "/changelog",
      "destination": "/products/grc360/changelog",
      "permanent": true
    },
    {
      "source": "/early-access",
      "destination": "/products/grc360/early-access",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/products/grc360/early-access",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/legal/privacy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/legal/terms",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/legal/dpa",
      "destination": "/terms",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-RQwPQSg8oDXosjddMeohLgsmoOgbUa5WH+K2dR5/gS0='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.cdninstagram.com https://*.fbcdn.net; font-src 'self'; connect-src 'self' blob: data: https://formspree.io; media-src 'self'; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/projects/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
